# Public web configuration
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Server-only configuration — never expose these in the browser
# A file URL is convenient locally; use a managed database adapter in production.
DATABASE_URL=sqlite:./data/poker.db
SESSION_SECRET=replace-with-a-long-random-secret
APP_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
# SMTP is required to deliver verification emails. Gmail example: smtp.gmail.com, port 465, secure=true.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Stackline Poker <no-reply@example.com>"
SMTP_SECURE=true
PORT=4000
