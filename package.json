{
  "name": "online-poker",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.9.3",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev --workspace=@online-poker/web",
    "dev:web": "npm run dev --workspace=@online-poker/web",
    "dev:server": "npm run dev --workspace=@online-poker/server",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace=@online-poker/poker-engine"
  }
}
